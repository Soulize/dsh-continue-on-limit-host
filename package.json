{
  "name": "dsh-continue-on-limit-host",
  "version": "0.4.1",
  "description": "Host-side global max-tokens auto-continuation for DeepSeek Harness with Follow-up and transparent same-turn Steer modes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "dsh-continue-on-limit.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "dsh-continue-on-limit.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soulize/dsh-continue-on-limit-host.git"
  },
  "homepage": "https://github.com/Soulize/dsh-continue-on-limit-host#readme",
  "bugs": {
    "url": "https://github.com/Soulize/dsh-continue-on-limit-host/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "auto-continue",
    "max-tokens",
    "background-session"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
